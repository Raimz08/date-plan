 body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 50%, #fecfef 100%);
            color: #333;
            line-height: 1.6;
        }
        h1 {
            text-align: center;
            color: #d63384;
            font-size: 2.2em;
            margin-bottom: 10px;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
        }
        .subtitle {
            text-align: center;
            color: #e91e63;
            font-size: 1.1em;
            margin-bottom: 30px;
        }
        .step {
            background: white;
            margin: 20px 0;
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            border-left: 6px solid #ff69b4;
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.6s ease;
            cursor: pointer;
        }
        .step.active {
            opacity: 1;
            transform: translateY(0);
        }
        .step:hover {
            transform: scale(1.02);
            box-shadow: 0 12px 35px rgba(0,0,0,0.15);
        }
        .step-header {
            display: flex;
            align-items: center;
            font-size: 1.3em;
            font-weight: bold;
            margin-bottom: 15px;
            color: #c2185b;
        }
        .step-icon {
            font-size: 1.8em;
            margin-right: 15px;
        }
        .step-content {
            display: none;
        }
        .step.active .step-content {
            display: block;
            animation: fadeIn 0.5s ease;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .tip {
            background: #fff3e0;
            padding: 12px;
            border-radius: 12px;
            border-left: 4px solid #ff9800;
            margin: 15px 0;
            font-style: italic;
        }
        .options {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 10px;
            margin-top: 15px;
        }
        .option {
            background: linear-gradient(45deg, #f8bbd9, #f48fb1);
            padding: 12px;
            border-radius: 12px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid transparent;
        }
        .option:hover, .option.selected {
            background: linear-gradient(45deg, #e91e63, #ad1457);
            color: white;
            border-color: #d81b60;
        }
        .checkbox-custom {
            transform: scale(1.5);
            margin-right: 10px;
        }
        button {
            background: linear-gradient(45deg, #ff69b4, #ff1493);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 50px;
            font-size: 1.1em;
            cursor: pointer;
            margin: 20px 10px;
            box-shadow: 0 6px 20px rgba(255,105,180,0.4);
            transition: all 0.3s;
        }
        button:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(255,105,180,0.6);
        }
        #customizeBtn {
            background: linear-gradient(45deg, #4caf50, #81c784);
        }
        #printBtn {
            background: linear-gradient(45deg, #2196f3, #64b5f6);
        }
        #progress {
            text-align: center;
            margin: 30px 0;
            font-size: 1.2em;
            color: #d81b60;
        }
        .completed {
            text-decoration: line-through;
            opacity: 0.7;
        }
        @media (max-width: 600px) {
            body { padding: 10px; }
            h1 { font-size: 1.8em; }
            .step { padding: 20px; }
        }
